        <script>
(function () {
  function corriger() {
    var paragraphes = document.querySelectorAll(".modal-error__p");
    for (var i = 0; i < paragraphes.length; i++) {
      var p = paragraphes[i];
      if (p.getAttribute("data-pl-fix")) continue;
      var m = p.textContent.match(/nous n.avons pas de stock pour\s*["\u201c\u00ab]\s*(.+?)\s*["\u201d\u00bb]/);
      if (!m) continue;
      var icone = p.querySelector("i");
      p.innerHTML = "";
      if (icone) p.appendChild(icone);
      p.appendChild(document.createTextNode(
        "\u00ab " + m[1] + " \u00bb n'est pas disponible imm\u00e9diatement : il vous sera exp\u00e9di\u00e9 d\u00e8s sa r\u00e9ception dans notre stock, comme indiqu\u00e9 sur sa fiche."
      ));
      p.setAttribute("data-pl-fix", "1");
    }
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", corriger);
  } else {
    corriger();
  }
  new MutationObserver(corriger).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
    






