							            <style>
            #paypal-message {
                max-height: 41px;
                overflow: hidden;
            }
        </style>
        <div
        id="paypal-message"
        data-pp-message
        data-pp-pageType="product-details"
        data-pp-amount="0.00"
        data-pp-style-layout="text"
        data-pp-placement="product"
        data-partner-attribution-id="WIZISHOP_Ecom_PPCP"
        style="margin-top:30px"
    ></div>
    <script src="https://www.paypal.com/sdk/js?client-id=BAAPaOyIjSbJP1gwTqCRzXLoS9wA4-ELc_HqdjA6UBVhERyPqcQ6oescrYb6AXld5a-bh1aj9jjKUQAXlI&currency=EUR&components=messages"></script>

    <script>
        function normalizePrice(rawText) {
            if (!rawText) return "0.00";
            let clean = rawText.replace(/[^\d.,]/g, "");

            if (clean.includes(",")) {
                clean = clean.replace(/\./g, "");
                clean = clean.replace(",", ".");
            }

            const value = parseFloat(clean);
            return isNaN(value) ? "0.00" : value.toFixed(2);
        }

        function updatePaypalMessage(newAmount) {
            const container = document.getElementById("paypal-message");
            container.setAttribute("data-pp-amount", newAmount);
            paypal.Messages().render(container);
        }

        document.addEventListener("DOMContentLoaded", () => {
            const priceEl = document.querySelector("#price .price-cur");

            if (!priceEl) return;

            const initialPrice = normalizePrice(priceEl.textContent.trim());
            console.log(initialPrice);
            updatePaypalMessage(initialPrice);

            const observer = new MutationObserver(() => {
                const newPrice = normalizePrice(priceEl.textContent.trim());
                updatePaypalMessage(newPrice);
            });

            observer.observe(priceEl, {
                childList: true,
                characterData: true,
                subtree: true
            });
        });
    </script>

