<script>
document.addEventListener('DOMContentLoaded', function () {

  var ref = document.querySelector('.prod-details__ref');
  var cible = document.getElementById('prod-add-cart');
  if (!ref || !cible) return;

  var t = ref.textContent.trim().toUpperCase();
  var type = '';
  if (t.indexOf('DF') === 0)      type = 'df';
  else if (t.indexOf('S') === 0)  type = 'stock';
  else if (t.indexOf('B') === 0)  type = 'bundle';
  else if (t.indexOf('P') === 0)  type = 'precommande';
  else return;

  var img24 = '<img src="https://media.cdnws.com/_i/424857/RAW-1418/20/22/expedition-sous-24h-produit-en-stock.png" alt="Expédié sous 24h - produit en stock Pop Licence" loading="lazy" decoding="async" style="width:clamp(150px,55%,220px);max-width:100%;height:auto;display:block;margin:0 auto 14px auto;">';

  var infos = {
    stock: {
      delai: 'Expédié sous 24h ouvrées, du lundi au vendredi',
      livraison: 'Livraison en point relais offerte dès 49 &#8364;',
      visuel: img24
    },
    bundle: {
      delai: 'Bundle expédié sous 24h ouvrées, du lundi au vendredi',
      livraison: 'Livraison en point relais offerte dès 49 &#8364;',
      visuel: img24
    },
    df: {
      delai: 'Expédié sous 24h par notre partenaire, livré sous 5 à 7 jours ouvrés',
      livraison: 'Livraison à domicile : 6,90 &#8364; quel que soit le montant',
      visuel: ''
    },
    precommande: {
      delai: 'Précommande : expédiée dès réception du stock',
      livraison: 'Livraison en point relais offerte dès 49 &#8364;',
      visuel: '<img src="https://media.cdnws.com/_i/424857/RAW-1419/362/23/precommande-reservez-le-votre-poplicence.png" alt="Précommande - réservez le vôtre, Pop Licence" loading="lazy" decoding="async" style="width:clamp(150px,55%,220px);max-width:100%;height:auto;display:block;margin:0 auto 14px auto;">'
    }
  };

  function ligne(chemin, couleur, fond, texte) {
    return '<li style="display:flex;align-items:center;gap:11px;padding:10px 0;border-bottom:1px solid #eef2f7;">'
      + '<span style="flex:0 0 auto;width:32px;height:32px;border-radius:10px;'
      +   'background:' + fond + ';display:flex;align-items:center;justify-content:center;">'
      +   '<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="' + couleur + '" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">'
      +     chemin
      +   '</svg>'
      + '</span>'
      + '<span style="font-size:clamp(13px,3.4vw,14px);line-height:1.5;color:#334155;">' + texte + '</span>'
      + '</li>';
  }

  var iLicence = '<path d="M12 2l2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8L3.5 8.2l5.9-.9z"/>';
  var iColis   = '<path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/>';
  var iCamion  = '<rect x="1" y="6" width="13" height="11" rx="1"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="5.5" cy="18.5" r="1.7"/><circle cx="17.5" cy="18.5" r="1.7"/>';
  var iCadenas = '<rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>';
  var iRetour  = '<path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/>';

  var bloc = document.createElement('div');
  bloc.className = 'pl-infos pl-infos--' + type;
  bloc.setAttribute('style',
    'margin-top:18px;'
    + 'background:#ffffff;'
    + 'border:1px solid #e2e8f0;'
    + 'border-radius:16px;'
    + 'padding:clamp(14px,4vw,20px);'
    + 'box-shadow:0 6px 20px rgba(15,23,42,0.05);'
  );

  bloc.innerHTML =
      infos[type].visuel

    + '<div style="display:flex;align-items:center;gap:9px;'
    +   'background:linear-gradient(135deg,#1d3557,#2a4a75);color:#ffffff;'
    +   'border-radius:999px;padding:10px 16px;'
    +   'margin:0 auto 14px auto;width:fit-content;max-width:100%;'
    +   'box-shadow:0 4px 12px rgba(29,53,87,0.25);">'
    +   '<svg viewBox="0 0 24 24" width="17" height="17" fill="#fbbf24" stroke="#fbbf24" stroke-width="1.5" stroke-linejoin="round" style="flex:0 0 auto;">'
    +     iLicence
    +   '</svg>'
    +   '<span style="font-size:clamp(12px,3.2vw,13px);font-weight:900;'
    +     'letter-spacing:.3px;line-height:1.3;">Produit sous licence officielle</span>'
    + '</div>'

    + '<p style="margin:0 0 14px 0;text-align:center;'
    +   'font-size:clamp(12px,3.1vw,13px);line-height:1.6;color:#64748b;">'
    +   'Acquis auprès de distributeurs et fabricants agréés.'
    + '</p>'

    + '<ul style="list-style:none;margin:0;padding:0;">'
    +   ligne(iColis,   '#059669', '#ecfdf5', '<strong>' + infos[type].delai + '</strong>')
    +   ligne(iCamion,  '#0284c7', '#eff6ff', infos[type].livraison)
    +   ligne(iCadenas, '#7c3aed', '#f5f3ff', 'Paiement sécurisé, carte bancaire 3D Secure')
    +   ligne(iRetour,  '#ea580c', '#fff7ed', '<strong>Retours gratuits</strong> sous 30 jours')
    + '</ul>';

  cible.parentNode.insertBefore(bloc, cible.nextSibling);
});
</script>
<style>
.pl-infos{
  margin-top:20px;
  padding:18px 20px 18px 22px;
  border-radius:14px;
  background:#ffffff;
  border:1px solid #e2e8f0;
  border-left:5px solid #cbd5e1;
  box-shadow:0 6px 18px rgba(15,23,42,0.06);
  font-size:14px;
  line-height:1.85;
  color:#64748b;
}
.pl-infos p{
  margin:0 0 4px 0;
  padding-left:20px;
  position:relative;
}
.pl-infos p:last-child{ margin-bottom:0; }
.pl-infos p::before{
  content:"";
  position:absolute;
  left:0;
  top:9px;
  width:8px;
  height:8px;
  border-radius:50%;
  background:#cbd5e1;
}
.pl-infos__delai{
  font-size:15px;
  font-weight:800;
  color:#111827;
  margin-bottom:10px !important;
}

.pl-infos--stock,
.pl-infos--bundle{ border-left-color:#15803D; }
.pl-infos--stock .pl-infos__delai,
.pl-infos--bundle .pl-infos__delai{ color:#15803D; }
.pl-infos--stock .pl-infos__delai::before,
.pl-infos--bundle .pl-infos__delai::before{ background:#15803D; }

.pl-infos--df{ border-left-color:#1D4ED8; }
.pl-infos--df .pl-infos__delai{ color:#1D4ED8; }
.pl-infos--df .pl-infos__delai::before{ background:#1D4ED8; }

.pl-infos--precommande{ border-left-color:#F97316; }
.pl-infos--precommande .pl-infos__delai{ color:#B45309; }
.pl-infos--precommande .pl-infos__delai::before{ background:#F97316; }
</style>
<script>
(function () {
  var TEXTE_D = 'Livré sous 5 à 7 J ouvrés';
  var TEXTE_P = 'Précommande, envoi à la sortie';
  function reference() {
    var m = document.querySelector('meta[name="product-ref"], meta[property="product-ref"]');
    if (m && m.content) return m.content.trim();
    var t = document.body.innerText;
    var r = t.match(/\b([SPDB]\d{6}|DF[A-Z0-9]{4,})\b/);
    return r ? r[1] : '';
  }
  function appliquer() {
    var badge = document.querySelector('#prod-stock .stock');
    if (!badge) return;
    var ref = reference().toUpperCase();
    if (/^[SB]\d{6}$/.test(ref)) {
      if (badge.classList.contains('stock-ok')) {
        badge.classList.add('stock-dispo');
      }
      return;
    }
    if (/^P\d{6}$/.test(ref)) {
      badge.classList.add('stock-preco');
      if (badge.textContent.trim() !== TEXTE_P) {
        badge.textContent = TEXTE_P;
      }
      return;
    }
    if (!/^D\d{6}$/.test(ref) && !/^DF/.test(ref)) return;
    document.querySelector('#prod-stock').classList.add('pl-df');
    badge.classList.add('stock-df');
    if (badge.textContent.trim() !== TEXTE_D) {
      badge.textContent = TEXTE_D;
    }
  }
  var n = 0;
  var minuteur = setInterval(function () {
    appliquer();
    if (++n > 60) clearInterval(minuteur);
  }, 500);
  document.addEventListener('DOMContentLoaded', appliquer);
  window.addEventListener('load', appliquer);
})();
</script>
<script>
/* =========================
   CORRECTION DU TEXTE DE LIVRAISON
   =========================
   Les fiches publiees avant le 19/09/2026 annoncent la
   livraison offerte sur les produits en direct
   fournisseur. C'est faux depuis la mise en place des
   6,90 EUR.

   Ce script corrige le texte a l'affichage. Il ne modifie
   AUCUNE fiche : les descriptions restent intactes, donc
   les variations ne risquent rien.

   Les fiches poussees depuis la correction des modeles
   portent deja le bon texte et ne sont pas touchees. */

document.addEventListener('DOMContentLoaded', function () {

  var nouveau = 'Les produits <strong>"Livraison sous 5 à 7 jours ouvrés"</strong>'
    + ' sont expédiés sous 24h par nos partenaires et livrés à domicile'
    + ' sous 5 à 7 jours ouvrés. Le transporteur et le numéro de suivi'
    + ' vous sont communiqués dès l\'expédition.'
    + ' <strong>Frais de livraison : 6,90 &#8364;, quel que soit le'
    + ' montant de la commande.</strong>';

  var paragraphes = document.querySelectorAll('p');

  for (var i = 0; i < paragraphes.length; i++) {

    var t = paragraphes[i].textContent || '';

    if (t.indexOf('Livraison sous 5 à 7 jours') === -1) continue;
    if (t.indexOf('sans minimum') === -1) continue;

    paragraphes[i].innerHTML = nouveau;
  }

  /* La phrase de bas de bloc, qui annonce seulement des
     delais differents alors que les frais le sont aussi. */

  var fin = 'pourront avoir des délais de livraison différents';

  for (var j = 0; j < paragraphes.length; j++) {

    var texte = paragraphes[j].textContent || '';

    if (texte.indexOf(fin) === -1) continue;

    paragraphes[j].innerHTML = paragraphes[j].innerHTML.replace(
      /pourront avoir des délais de livraison différents/,
      'auront des délais et des frais de livraison propres à chaque envoi'
    );
  }

});
</script>
