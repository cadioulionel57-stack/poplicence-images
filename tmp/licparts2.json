n!important;background:#fff!important;border:1px solid #e2e8f0!important;border-radius:20px!important;overflow:hidden!important;text-decoration:none!important;color:#001D48!important;transition:transform .25s,box-shadow .25s!important}\n.plx-c:hover{transform:translateY(-6px)!important;box-shadow:0 16px 34px rgba(0,29,72,.12)!important}\n.plx-ci{background:#F8FAFC!important;aspect-ratio:4/3!important;display:flex!important;align-items:center!important;justify-content:center!important;padding:18px!important}\n.plx-ci img{max-width:100%!important;max-height:100%!important;width:auto!important;height:auto!important;object-fit:contain!important;display:block!important}\n.plx-cb{padding:18px 20px 22px 20px!important}\n.plx-cb em{display:inline-block!important;font-style:normal!important;background:#fbbf24!important;color:#001D48!important;border-radius:999px!important;padding:4px 11px!important;font-size:11px!important;font-weight:900!important;margin-bottom:10px!important}\n.plx-cb strong{display:block!important;font-size:20px!important;line-height:1.25!important;font-weight:900!important;margin-bottom:6px!important}\n.plx-cb span{display:block!important;font-size:14px!important;line-height:1.6!important;color:#64748b!important}\n.plx-why{border-radius:24px!important;background:#001D48!important;padding:48px 40px!important;color:#fff!important}\n.plx-why .plx-h2{color:#fff!important;margin-bottom:28px!important}\n.plx-wg{display:grid!important;grid-template-columns:repeat(3,1fr)!important;gap:18px!important}\n.plx-w{background:rgba(255,255,255,.07)!important;border:1px solid rgba(255,255,255,.14)!important;border-radius:18px!important;padding:24px!important}\n.plx-w b{display:block!important;font-size:18px!important;font-weight:900!important;color:#fbbf24!important;margin-bottom:10px!important}\n.plx-w span{font-size:14px!important;line-height:1.8!important;color:#dbe4f3!important}\n.plx-new{border-radius:24px!important;background:#EEF4FB!important;padding:40px 32px!important;text-align:center!important}\n.plx-new .plx-sub{margin-bottom:24px!important}\n.plx-seo{padding-bottom:48px!important}\n.plx-seo h2{margin:0 0 14px 0!important;font-size:26px!important;line-height:1.3!important;font-weight:900!important;color:#001D48!important}\n.plx-seo p{margin:0 0 12px 0!important;font-size:15px!important;line-height:1.9!important;color:#475569!important}\n.plx-seo a{color:#001D48!important;font-weight:800!important}\n@media (max-width:900px){\n.plx-hero{grid-template-columns:1fr!important;padding:32px 22px!important;gap:26px!important;text-align:center!important}\n.plx-lead{margin-left:auto!important;margin-right:auto!important}\n.plx-btns{justify-content:center!important}\n.plx-h1{font-size:38px!important}\n.plx-prods{grid-template-columns:repeat(4,1fr)!important;gap:10px!important;max-width:none!important}\n.plx-p{border-radius:12px!important;padding:8px!important}\n.plx-p:nth-child(2),.plx-p:nth-child(4){transform:none!important}\n.plx-adv{grid-template-columns:repeat(2,1fr)!important}\n.plx-cats{grid-template-columns:repeat(2,1fr)!important;gap:14px!important}\n.plx-wg{grid-template-columns:1fr!important}\n.plx-h2{font-size:28px!important}\n}\n@media (max-width:520px){\n.plx-sec{margin-top:40px!important}\n.plx-h1{font-size:32px!important}\n.plx-lead{font-size:15px!important}\n.plx-b1,.plx-b2{padding:13px 18px!important;font-size:13px!important}\n.plx-cb{padding:14px 14px 16px 14px!important}\n.plx-cb strong{font-size:16px!important}\n.plx-cb span{font-size:12.5px!important}\n.plx-ci{padding:12px!important}\n.plx-why{padding:32px 20px!important}\n.plx-new{padding:30px 18px!important}\n.plx-h2{font-size:24px!important}\n}\n</style>\n<div class=\"plx\">\n<section class=\"plx-hero\">\n<div class=\"plx-txt\">\n<div class=\"plx-eb\">Produits sous licence officielle</div>\n<h1 class=\"plx-h1\">Harry <span>Potter</span></h1>\n<p class=\"plx-lead\">Poudlard, les quatre maisons et tout l'univers des sorciers : coffrets cadeaux, mugs, papeterie, peluches et décoration pour les fans de la saga.</p>\n<div class=\"plx-btns\"><a class=\"plx-b1\" href=\"https://poplicence.fr/m/harry-potter/\">Voir tous les produits</a><a class=\"plx-b2\" href=\"https://poplicence.fr/nouveautes/m/harry-potter/\">Nouveautés</a></div>\n</div>\n<div class=\"plx-prods\"><div class=\"plx-p\"><img src=\"https://media.cdnws.com/_i/424857/2345/3316/48/coffret-cadeau-harry-potter-valise-poudlard-mug-3d-porte-cles-pins-1.jpeg\" alt=\"Coffret cadeau Harry Potter Valise Poudlard\" width=\"400\" height=\"400\" decoding=\"async\" fetchpriority=\"high\"></div><div class=\"plx-p\"><img src=\"https://media.cdnws.com/_i/424857/2330/52/33/mug-3d-harry-potter-quatre-maisons-650-ml-1.jpeg\" alt=\"Mug 3D Harry Potter Quatre maisons\" width=\"400\" height=\"400\" decoding=\"async\"></div><div class=\"plx-p\"><img src=\"https://media.cdnws.com/_i/424857/982/2563/86/funko-pop-harry-potter-hedwige-76-1.jpeg\" alt=\"Funko Pop Harry Potter Hedwige\" width=\"400\" height=\"400\" decoding=\"async\"></div><div class=\"plx-p\"><img src=\"https://media.cdnws.com/_i/424857/610/1748/11/boule-a-neige-harry-potter-boite-cadeau-1.jpeg\" alt=\"Boule à neige Harry Potter\" width=\"400\" height=\"400\" decoding=\"async\"></div></div>\n</section>\n<section class=\"plx-sec\"><div class=\"plx-adv\">\n<div class=\"plx-a\"><i></i><b>Produits officiels</b><span>Sous licence officielle garantie.</span></div>\n<div class=\"plx-a\"><i></i><b>Envoi rapide</b><span>Produits en stock envoyés le jour même.</span></div>\n<div class=\"plx-a\"><i></i><b>Retours offerts</b><span>30&nbsp;jours pour changer d'avis.</span></div>\n<div class=\"plx-a\"><i></i><b>Point relais 4,10&nbsp;&#8364;</b><span>Offert dès 49&nbsp;&#8364; d'achat.</span></div>\n</div></section>\n<section class=\"plx-sec\">\n<h2 class=\"plx-h2\">Explorer l'univers Harry Potter</h2>\n<p class=\"plx-sub\">Retrouvez les principales catégories Harry Potter, de la papeterie au linge de maison.</p>\n<div class=\"plx-cats\"><a class=\"plx-c\" href=\"https://poplicence.fr/papeterie/m/harry-potter/\"><div class=\"plx-ci\"><img src=\"https://media.cdnws.com/_i/424857/1000/1938/0/carnet-harry-potter-en-simili-cuir-vue-face.jpeg\" alt=\"Papeterie Harry Potter\" width=\"400\" height=\"300\" loading=\"lazy\" decoding=\"async\"></div><div class=\"plx-cb\"><em>Lifestyle</em><strong>Papeterie</strong><span>Carnets, classeurs et porte-vues.</span></div></a><a class=\"plx-c\" href=\"https://poplicence.fr/cuisine-et-vaisselle/m/harry-potter/\"><div class=\"plx-ci\"><img src=\"https://media.cdnws.com/_i/424857/607/1907/8/gourde-isotherme-harry-potter-magic-mayhem-en-inox-515-ml-1.jpeg\" alt=\"Cuisine et mugs Harry Potter\" width=\"400\" height=\"300\" loading=\"lazy\" decoding=\"async\"></div><div class=\"plx-cb\"><em>Maison</em><strong>Cuisine &amp; mugs</strong><span>Mugs 3D, gourdes et assiettes.</span></div></a><a class=\"plx-c\" href=\"https://poplicence.fr/idees-cadeaux/coffrets-cadeaux/m/harry-potter/\"><div class=\"plx-ci\"><img src=\"https://media.cdnws.com/_i/424857/2382/3422/85/coffret-cadeau-harry-potter-poudlard-mug-acryl-cartes-postales-1.jpeg\" alt=\"Coffrets cadeaux Harry Potter\" width=\"400\" height=\"300\" loading=\"lazy\" decoding=\"async\"></div><div class=\"plx-cb\"><em>Cadeaux</em><strong>Coffrets cadeaux</strong><span>Valise Poudlard, coffrets mug et bougie.</span></div></a><a class=\"plx-c\" href=\"https://poplicence.fr/linge-de-maison/m/harry-potter/\"><div class=\"plx-ci\"><img src=\"https://media.cdnws.com/_i/424857/2410/448/14/serviette-de-bain-hp-serpentard-90x180-1.jpeg\" alt=\"Linge de maison Harry Potter\" width=\"400\" height=\"300\" loading=\"lazy\" decoding=\"async\"></div><div class=\"plx-cb\"><em>Maison</em><strong>Linge de maison</strong><span>Serviettes des maisons, draps et plaids.</span></div></a><a class=\"plx-c\" href=\"https://poplicence.fr/accessoires-de-mode/m/harry-potter/\"><div class=\"plx-ci\"><img src=\"https://media.cdnws.com/_i/424857/381/1100/84/chaussettes-harry-potter-boite.jpeg\" alt=\"Accessoires Harry Potter\" width=\"400\" height=\"300\" loading=\"lazy\" decoding=\"async\"></div><div class=\"plx-cb\"><em>Mode</em><strong>Accessoires</strong><span>Écharpes des maisons et chaussettes.</span></div></a><a class=\"plx-c\" href=\"https://poplicence.fr/decoration/m/harry-potter/\"><div class=\"plx-ci\"><img src=\"https://media.cdnws.com/_i/424857/610/1748/11/boule-a-neige-harry-potter-boite-cadeau-1.jpeg\" alt=\"Décoration Harry Potter\" width=\"400\" height=\"300\" loading=\"lazy\" decoding=\"async\"></div><div class=\"plx-cb\"><em>Maison</em><strong>Décoration</strong><span>Boules à neige, serre-livres et coussins.</span></div></a></div>\n</section>\n</div>", "hp2": "<!-- PAGE LICENCE HARRY POTTER - PARTIE 2 -->\n<div class=\"plx\">\n<section class=\"plx-why\">\n<h2 class=\"plx-h2\">Pourquoi choisir Harry Potter ?</h2>\n<div class=\"plx-wg\"><div class=\"plx-w\"><b>Une saga qui traverse les générations</b><span>Des lecteurs de la première heure aux enfants d'aujourd'hui, Poudlard réunit tous les âges.</span></div><div class=\"plx-w\"><b>Quatre maisons, quatre identités</b><span>Gryffondor, Serpentard, Serdaigle ou Poufsouffle : chaque fan a la sienne, et chaque produit ses couleurs.</span></div><div class=\"plx-w\"><b>Le cadeau qui ne déçoit jamais</b><span>Coffrets, mugs, carnets, peluches ou collectors : il y a un cadeau Harry Potter pour chaque budget.</span></div></div>\n</section>\n<section class=\"plx-sec plx-new\">\n<h2 class=\"plx-h2\">Nouveautés Harry Potter</h2>\n<p class=\"plx-sub\">De nouvelles références arrivent régulièrement. Découvrez les dernières arrivées de l'univers Harry Potter.</p>\n<a class=\"plx-b1\" href=\"https://poplicence.fr/nouveautes/m/harry-potter/\">Voir les nouveautés</a>\n</section>\n<section class=\"plx-sec plx-seo\">\n<h2>Produits dérivés Harry Potter officiels</h2>\n<p>Retrouvez sur Pop Licence une sélection de <strong>produits dérivés Harry Potter</strong> sous licence officielle : papeterie, mugs et gourdes, coffrets cadeaux, peluches, écharpes des quatre maisons et objets de décoration.</p><p>Que vous soyez Gryffondor, Serpentard, Serdaigle ou Poufsouffle, l'univers de Poudlard accompagne aussi bien les jeunes sorciers que les fans de la première heure. Chaque article est un produit officiel, envoyé depuis la Bretagne.</p><p>Découvrez également nos <a href=\"https://poplicence.fr/idees-cadeaux/m/harry-potter/\">idées cadeaux Harry Potter</a> ainsi que l'ensemble de nos <a href=\"https://poplicence.fr/univers-et-licences/\">Univers &amp; Licences</a>.</p>\n</section>\n</div>", "st1": "<!-- PAGE LICENCE LILO &AMP; STITCH - PARTIE 1 -->\n<style>\n.plx{max-width:1300px!important;margin:0 auto!important;padding:0 16px!important;font-family:'Nunito Sans',Arial,sans-serif!important;color:#001D48!important;box-sizing:border-box!important}\n.plx *{box-sizing:border-box!important}\n.plx-hero{position:relative!important;overflow:hidden!important;border-radius:24px!important;background:radial-gradient(ellipse 70% 120% at 80% 50%,#0d3470 0%,#062a5e 40%,#001D48 75%)!important;display:grid!important;grid-template-columns:1.05fr 1fr!important;gap:32px!important;align-items:center!important;padding:44px 56px 56px 56px!important}\n.plx-hero:before{content:\"\";position:absolute!important;right:-120px!important;top:-160px!important;width:620px!important;height:620px!important;border-radius:50%!important;background:radial-gradient(circle,rgba(251,191,36,.22),rgba(251,191,36,0) 65%)!important}\n.plx-txt{position:relative!important;z-index:1!important;color:#fff!important}\n.plx-eb{display:inline-block!important;background:#fbbf24!important;color:#001D48!important;border-radius:999px!important;padding:8px 16px!important;font-size:12px!important;font-weight:900!important;letter-spacing:.08em!important;text-transform:uppercase!important;margin-bottom:18px!important}\n.plx-h1{margin:0 0 16px 0!important;font-size:52px!important;line-height:1.05!import